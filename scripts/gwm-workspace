#!/bin/bash

set -euo pipefail

program=${0##*/}
registry=${GWM_WORKSPACES_FILE:-"${XDG_CONFIG_HOME:-$HOME/.config}/gwm/workspaces"}

usage() {
  cat <<EOF
usage: $program list [--format names|tsv]
       $program open <workspace> [gwm arguments...]
       $program folders
       $program open-folder <repository> [gwm arguments...]
       $program sync <workspace|--all>
       $program repos <workspace>
       $program create <scope/name>
       $program add <workspace> [repository]
       $program remove <workspace> <repository-name>

Workspace manifests are <name>.code-workspace files. Their sibling <name>/
directories are managed projections containing repository symlinks for GWM.
EOF
}

die() {
  echo "$program: $*" >&2
  exit 1
}

expand_home() {
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

require_tools() {
  local tool
  for tool in git jq perl; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
  done
}

workspace_homes() {
  [[ -f $registry ]] || return 0

  local scope home
  while IFS='|' read -r scope home; do
    case $scope in
      ""|'#'*) continue ;;
    esac
    [[ -n $home ]] || continue
    home=$(expand_home "$home")
    if [[ -d $home ]]; then
      home=$(cd "$home" && pwd -P)
    fi
    printf '%s\t%s\n' "$scope" "$home"
  done < "$registry"
}

workspace_rows() {
  local scope home manifest name
  while IFS=$'\t' read -r scope home; do
    [[ -d $home ]] || continue
    while IFS= read -r -d '' manifest; do
      name=${manifest##*/}
      name=${name%.code-workspace}
      printf '%s/%s\t%s\t%s\n' "$scope" "$name" "$manifest" "$home/$name"
    done < <(find "$home" -maxdepth 1 -type f -name '*.code-workspace' -print0 | sort -z)
  done < <(workspace_homes)
}

resolve_workspace() {
  local selector=$1 row id manifest directory matches=0
  WORKSPACE_ID=
  WORKSPACE_MANIFEST=
  WORKSPACE_DIRECTORY=

  if [[ $selector == *.code-workspace && -f $selector ]]; then
    WORKSPACE_MANIFEST=$(cd "$(dirname "$selector")" && pwd -P)/$(basename "$selector")
    WORKSPACE_ID=${selector##*/}
    WORKSPACE_ID=${WORKSPACE_ID%.code-workspace}
    WORKSPACE_DIRECTORY=${WORKSPACE_MANIFEST%.code-workspace}
    return 0
  fi

  while IFS= read -r row; do
    IFS=$'\t' read -r id manifest directory <<< "$row"
    if [[ $selector == "$id" || $selector == "${id#*/}" ]]; then
      WORKSPACE_ID=$id
      WORKSPACE_MANIFEST=$manifest
      WORKSPACE_DIRECTORY=$directory
      matches=$((matches + 1))
    fi
  done < <(workspace_rows)

  [[ $matches -gt 0 ]] || die "unknown workspace: $selector"
  [[ $matches -eq 1 ]] || die "ambiguous workspace '$selector'; use its scope/name"
}

list_workspaces() {
  local format=${1:-table} id manifest directory count state
  case $format in
    table|names|tsv) ;;
    *) die "unknown list format: $format" ;;
  esac

  if [[ $format == table ]]; then
    printf '%-28s %5s  %s\n' WORKSPACE REPOS DIRECTORY
  fi

  while IFS=$'\t' read -r id manifest directory; do
    count=$(jq '.folders // [] | length' "$manifest")
    state=$directory
    [[ -d $directory ]] || state="$directory (not synced)"
    case $format in
      names) printf '%s\n' "$id" ;;
      tsv) printf '%s\t%s\t%s\t%s\n' "$id" "$count" "$manifest" "$directory" ;;
      table) printf '%-28s %5s  %s\n' "$id" "$count" "$state" ;;
    esac
  done < <(workspace_rows)
}

relative_path() {
  perl -MFile::Spec -e 'print File::Spec->abs2rel($ARGV[0], $ARGV[1])' "$1" "$2"
}

sync_resolved_workspace() {
  local manifest_dir desired folder_name folder_path target repo link_name link_path relative
  local linked=0 skipped=0
  manifest_dir=${WORKSPACE_MANIFEST%/*}
  mkdir -p "$WORKSPACE_DIRECTORY"
  desired=$(mktemp "${TMPDIR:-/tmp}/gwm-workspace-links.XXXXXX")

  while IFS=$'\t' read -r folder_path folder_name; do
    [[ -n $folder_path ]] || continue
    if [[ $folder_path == /* ]]; then
      target=$folder_path
    else
      target=$manifest_dir/$folder_path
    fi

    if [[ ! -d $target ]]; then
      echo "$program: warning: missing workspace folder: $folder_path" >&2
      skipped=$((skipped + 1))
      continue
    fi

    target=$(cd "$target" && pwd -P)
    if ! repo=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null); then
      echo "$program: warning: not a Git repository: $target" >&2
      skipped=$((skipped + 1))
      continue
    fi
    repo=$(cd "$repo" && pwd -P)

    link_name=${folder_name:-${repo##*/}}
    link_name=${link_name//\//--}
    [[ -n $link_name && $link_name != . && $link_name != .. ]] || die "invalid link name for $folder_path"
    if grep -Fqx "$link_name" "$desired"; then
      die "duplicate repository name '$link_name' in $WORKSPACE_ID; set a unique folder name"
    fi
    printf '%s\n' "$link_name" >> "$desired"

    link_path=$WORKSPACE_DIRECTORY/$link_name
    relative=$(relative_path "$repo" "$WORKSPACE_DIRECTORY")
    if [[ -L $link_path ]]; then
      if [[ $(readlink "$link_path") != "$relative" ]]; then
        unlink "$link_path"
        ln -s "$relative" "$link_path"
      fi
    elif [[ -e $link_path ]]; then
      die "managed path is not a symlink: $link_path"
    else
      ln -s "$relative" "$link_path"
    fi
    linked=$((linked + 1))
  done < <(jq -r '.folders[]? | [.path, (.name // "")] | @tsv' "$WORKSPACE_MANIFEST")

  local existing existing_name
  while IFS= read -r -d '' existing; do
    existing_name=${existing##*/}
    if ! grep -Fqx "$existing_name" "$desired"; then
      unlink "$existing"
    fi
  done < <(find "$WORKSPACE_DIRECTORY" -maxdepth 1 -type l -print0)

  rm -f "$desired"
  printf '%s: %d repositories linked' "$WORKSPACE_ID" "$linked"
  if [[ $skipped -gt 0 ]]; then
    printf ', %d skipped' "$skipped"
  fi
  printf '\n'
}

sync_workspace() {
  resolve_workspace "$1"
  sync_resolved_workspace
}

create_workspace() {
  local selector=$1 scope name configured_scope home found=0
  [[ $selector == */* ]] || die "create requires a qualified scope/name"
  scope=${selector%%/*}
  name=${selector#*/}
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid workspace name: $name"

  while IFS=$'\t' read -r configured_scope home; do
    [[ $configured_scope == "$scope" ]] || continue
    found=1
    mkdir -p "$home"
    [[ ! -e $home/$name.code-workspace && ! -e $home/$name ]] || die "workspace already exists: $selector"
    printf '{\n  "folders": []\n}\n' > "$home/$name.code-workspace"
    mkdir "$home/$name"
    printf '%s\n' "$selector"
  done < <(workspace_homes)

  [[ $found -eq 1 ]] || die "unknown workspace scope: $scope"
}

add_repository() {
  local selector=$1 requested_repo=${2:-$PWD} repo main_repo manifest_dir relative temporary existing_path existing_target
  resolve_workspace "$selector"
  repo=$(git -C "$requested_repo" rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository: $requested_repo"
  repo=$(cd "$repo" && pwd -P)
  main_repo=$(git -C "$repo" worktree list --porcelain | sed -n '1s/^worktree //p')
  [[ -n $main_repo ]] || die "cannot resolve the main worktree for: $repo"
  repo=$(cd "$main_repo" && pwd -P)
  manifest_dir=${WORKSPACE_MANIFEST%/*}

  while IFS= read -r existing_path; do
    if [[ $existing_path == /* ]]; then
      existing_target=$existing_path
    else
      existing_target=$manifest_dir/$existing_path
    fi
    if [[ -d $existing_target && $(cd "$existing_target" && pwd -P) == "$repo" ]]; then
      die "repository is already in $WORKSPACE_ID: $repo"
    fi
  done < <(jq -r '.folders[]?.path' "$WORKSPACE_MANIFEST")

  relative=$(relative_path "$repo" "$manifest_dir")
  temporary=$(mktemp "$manifest_dir/.${WORKSPACE_ID#*/}.XXXXXX")
  jq --arg path "$relative" '.folders = ((.folders // []) + [{path: $path}])' "$WORKSPACE_MANIFEST" > "$temporary"
  mv "$temporary" "$WORKSPACE_MANIFEST"
  sync_resolved_workspace
}

remove_repository() {
  local selector=$1 repository_name=$2 matches temporary
  resolve_workspace "$selector"
  matches=$(jq --arg name "$repository_name" '[.folders[]? | select((.name // (.path | split("/")[-1])) == $name)] | length' "$WORKSPACE_MANIFEST")
  [[ $matches -gt 0 ]] || die "repository '$repository_name' is not in $WORKSPACE_ID"
  [[ $matches -eq 1 ]] || die "repository name '$repository_name' is ambiguous in $WORKSPACE_ID"

  temporary=$(mktemp "${WORKSPACE_MANIFEST%/*}/.${WORKSPACE_ID#*/}.XXXXXX")
  jq --arg name "$repository_name" '.folders = [.folders[]? | select((.name // (.path | split("/")[-1])) != $name)]' "$WORKSPACE_MANIFEST" > "$temporary"
  mv "$temporary" "$WORKSPACE_MANIFEST"
  sync_resolved_workspace
}

list_repositories() {
  local selector=$1 link
  resolve_workspace "$selector"
  sync_resolved_workspace >/dev/null
  while IFS= read -r -d '' link; do
    printf '%s\t%s\n' "${link##*/}" "$(cd "$(dirname "$link")/$(readlink "$link")" && pwd -P)"
  done < <(find "$WORKSPACE_DIRECTORY" -maxdepth 1 -type l -print0 | sort -z)
}

list_folders() {
  local temporary id manifest directory manifest_dir folder_path target repo main_repo
  temporary=$(mktemp "${TMPDIR:-/tmp}/gwm-workspace-folders.XXXXXX")

  while IFS=$'\t' read -r id manifest directory; do
    manifest_dir=${manifest%/*}
    while IFS= read -r folder_path; do
      if [[ $folder_path == /* ]]; then
        target=$folder_path
      else
        target=$manifest_dir/$folder_path
      fi
      [[ -d $target ]] || continue
      repo=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null) || continue
      main_repo=$(git -C "$repo" worktree list --porcelain | sed -n '1s/^worktree //p')
      [[ -n $main_repo ]] || continue
      repo=$(cd "$main_repo" && pwd -P)
      printf '%s\n' "$repo" >> "$temporary"
    done < <(jq -r '.folders[]?.path' "$manifest")
  done < <(workspace_rows)

  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    printf '%s\t%s\n' "${repo##*/}" "$repo"
  done < <(sort -u "$temporary")
  rm -f "$temporary"
}

open_folder() {
  local requested=$1 repo
  shift
  repo=$(git -C "$requested" rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository: $requested"
  repo=$(cd "$repo" && pwd -P)
  cd "$repo"
  exec gwm "$@"
}

require_tools
command=${1:-}
[[ -n $command ]] || { usage; exit 2; }
shift

case $command in
  list)
    format=table
    if [[ ${1:-} == --format ]]; then
      [[ $# -ge 2 ]] || die "--format requires a value"
      format=$2
    fi
    list_workspaces "$format"
    ;;
  open)
    [[ $# -ge 1 ]] || die "open requires a workspace"
    selector=$1
    shift
    command -v gwm >/dev/null 2>&1 || die "gwm is not installed (brew install kbrdn1/tap/gwm)"
    resolve_workspace "$selector"
    sync_resolved_workspace >&2
    exec gwm --workspace "$WORKSPACE_DIRECTORY" "$@"
    ;;
  folders)
    [[ $# -eq 0 ]] || die "folders accepts no arguments"
    list_folders
    ;;
  open-folder)
    [[ $# -ge 1 ]] || die "open-folder requires a repository"
    command -v gwm >/dev/null 2>&1 || die "gwm is not installed (brew install kbrdn1/tap/gwm)"
    open_folder "$@"
    ;;
  sync)
    [[ $# -eq 1 ]] || die "sync requires a workspace or --all"
    if [[ $1 == --all ]]; then
      while IFS= read -r selector; do
        sync_workspace "$selector"
      done < <(list_workspaces names)
    else
      sync_workspace "$1"
    fi
    ;;
  repos)
    [[ $# -eq 1 ]] || die "repos requires a workspace"
    list_repositories "$1"
    ;;
  create)
    [[ $# -eq 1 ]] || die "create requires scope/name"
    create_workspace "$1"
    ;;
  add)
    [[ $# -ge 1 && $# -le 2 ]] || die "add requires a workspace and optional repository"
    add_repository "$@"
    ;;
  remove)
    [[ $# -eq 2 ]] || die "remove requires a workspace and repository name"
    remove_repository "$1" "$2"
    ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command" ;;
esac
