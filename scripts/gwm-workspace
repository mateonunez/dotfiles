#!/bin/bash

set -euo pipefail

program=${0##*/}
registry=${GWM_WORKSPACES_FILE:-"${XDG_CONFIG_HOME:-$HOME/.config}/gwm/workspaces"}

usage() {
  cat <<EOF
usage: $program
       $program list [--format names|tsv]
       $program open <workspace> [gwm arguments...]
       $program repos <workspace>
       $program create <scope/name>
       $program add <workspace> [repository]
       $program remove <workspace> <repository-name>

With no arguments, GWM runs natively from the current directory. A managed
workspace is a directory whose direct children are repository symlinks.
EOF
}

die() {
  echo "$program: $*" >&2
  exit 1
}

expand_home() {
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

require_tools() {
  local tool
  for tool in git perl; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
  done
}

workspace_homes() {
  [[ -f $registry ]] || return 0

  local scope home
  while IFS='|' read -r scope home; do
    case $scope in
      ""|'#'*) continue ;;
    esac
    [[ -n $home ]] || continue
    home=$(expand_home "$home")
    if [[ -d $home ]]; then
      home=$(cd "$home" && pwd -P)
    fi
    printf '%s\t%s\n' "$scope" "$home"
  done < "$registry"
}

workspace_rows() {
  local scope home directory name
  while IFS=$'\t' read -r scope home; do
    [[ -d $home ]] || continue
    while IFS= read -r -d '' directory; do
      name=${directory##*/}
      printf '%s/%s\t%s\n' "$scope" "$name" "$directory"
    done < <(find "$home" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
  done < <(workspace_homes)
}

resolve_workspace() {
  local selector=$1 row id directory matches=0
  WORKSPACE_ID=
  WORKSPACE_DIRECTORY=

  while IFS= read -r row; do
    IFS=$'\t' read -r id directory <<< "$row"
    if [[ $selector == "$id" || $selector == "${id#*/}" ]]; then
      WORKSPACE_ID=$id
      WORKSPACE_DIRECTORY=$directory
      matches=$((matches + 1))
    fi
  done < <(workspace_rows)

  [[ $matches -gt 0 ]] || die "unknown workspace: $selector"
  [[ $matches -eq 1 ]] || die "ambiguous workspace '$selector'; use its scope/name"
}

repository_count() {
  find "$1" -mindepth 1 -maxdepth 1 -type l -print | wc -l | tr -d ' '
}

list_workspaces() {
  local format=${1:-table} id directory count
  case $format in
    table|names|tsv) ;;
    *) die "unknown list format: $format" ;;
  esac

  [[ $format != table ]] || printf '%-42s %5s  %s\n' WORKSPACE REPOS DIRECTORY
  while IFS=$'\t' read -r id directory; do
    count=$(repository_count "$directory")
    case $format in
      names) printf '%s\n' "$id" ;;
      tsv) printf '%s\t%s\t%s\n' "$id" "$count" "$directory" ;;
      table) printf '%-42s %5s  %s\n' "$id" "$count" "$directory" ;;
    esac
  done < <(workspace_rows)
}

relative_path() {
  perl -MFile::Spec -e 'print File::Spec->abs2rel($ARGV[0], $ARGV[1])' "$1" "$2"
}

main_repository() {
  local requested=$1 repo main_repo
  repo=$(git -C "$requested" rev-parse --show-toplevel 2>/dev/null) || return 1
  repo=$(cd "$repo" && pwd -P)
  main_repo=$(git -C "$repo" worktree list --porcelain | sed -n '1s/^worktree //p')
  [[ -n $main_repo ]] || return 1
  cd "$main_repo" && pwd -P
}

create_workspace() {
  local selector=$1 scope name configured_scope home found=0
  [[ $selector == */* ]] || die "create requires a qualified scope/name"
  scope=${selector%%/*}
  name=${selector#*/}
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid workspace name: $name"

  while IFS=$'\t' read -r configured_scope home; do
    [[ $configured_scope == "$scope" ]] || continue
    found=1
    mkdir -p "$home"
    [[ ! -e $home/$name ]] || die "workspace already exists: $selector"
    mkdir "$home/$name"
    printf '%s\n' "$selector"
  done < <(workspace_homes)

  [[ $found -eq 1 ]] || die "unknown workspace scope: $scope"
}

add_repository() {
  local selector=$1 requested_repo=${2:-$PWD} repo name link_path relative existing existing_target
  resolve_workspace "$selector"
  repo=$(main_repository "$requested_repo") || die "not inside a Git repository: $requested_repo"

  while IFS= read -r -d '' existing; do
    existing_target=$(cd "$(dirname "$existing")/$(readlink "$existing")" && pwd -P)
    [[ $existing_target != "$repo" ]] || die "repository is already in $WORKSPACE_ID: $repo"
  done < <(find "$WORKSPACE_DIRECTORY" -mindepth 1 -maxdepth 1 -type l -print0)

  name=${repo##*/}
  link_path=$WORKSPACE_DIRECTORY/$name
  [[ ! -e $link_path && ! -L $link_path ]] || die "workspace entry already exists: $link_path"
  relative=$(relative_path "$repo" "$WORKSPACE_DIRECTORY")
  ln -s "$relative" "$link_path"
  printf '%s: added %s\n' "$WORKSPACE_ID" "$name"
}

remove_repository() {
  local selector=$1 repository_name=$2 link_path
  resolve_workspace "$selector"
  link_path=$WORKSPACE_DIRECTORY/$repository_name
  [[ -L $link_path ]] || die "repository '$repository_name' is not in $WORKSPACE_ID"
  unlink "$link_path"
  printf '%s: removed %s\n' "$WORKSPACE_ID" "$repository_name"
}

list_repositories() {
  local selector=$1 link target
  resolve_workspace "$selector"
  while IFS= read -r -d '' link; do
    target=$(cd "$(dirname "$link")/$(readlink "$link")" && pwd -P)
    printf '%s\t%s\n' "${link##*/}" "$target"
  done < <(find "$WORKSPACE_DIRECTORY" -mindepth 1 -maxdepth 1 -type l -print0 | sort -z)
}

require_tools
if [[ $# -eq 0 ]]; then
  command -v gwm >/dev/null 2>&1 || die "gwm is not installed (brew install kbrdn1/tap/gwm)"
  exec gwm
fi

command=$1
shift
case $command in
  list)
    format=table
    if [[ ${1:-} == --format ]]; then
      [[ $# -ge 2 ]] || die "--format requires a value"
      format=$2
    fi
    list_workspaces "$format"
    ;;
  open)
    [[ $# -ge 1 ]] || die "open requires a workspace"
    selector=$1
    shift
    command -v gwm >/dev/null 2>&1 || die "gwm is not installed (brew install kbrdn1/tap/gwm)"
    resolve_workspace "$selector"
    exec gwm --workspace "$WORKSPACE_DIRECTORY" "$@"
    ;;
  repos)
    [[ $# -eq 1 ]] || die "repos requires a workspace"
    list_repositories "$1"
    ;;
  create)
    [[ $# -eq 1 ]] || die "create requires scope/name"
    create_workspace "$1"
    ;;
  add)
    [[ $# -ge 1 && $# -le 2 ]] || die "add requires a workspace and optional repository"
    add_repository "$@"
    ;;
  remove)
    [[ $# -eq 2 ]] || die "remove requires a workspace and repository name"
    remove_repository "$1" "$2"
    ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command" ;;
esac
